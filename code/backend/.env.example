# Obligatorias: sin ellas la app no arranca. En producción usa claves nuevas:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me
# Apagado si se omite. Solo True en desarrollo local.
DEBUG=True
# Dominios del backend separados por comas (obligatorio con DEBUG=False), ej.:
#   ALLOWED_HOSTS=api.erp.flebosil.com
ALLOWED_HOSTS=
# Orígenes HTTPS del admin de Django (formularios con CSRF), ej.:
#   CSRF_TRUSTED_ORIGINS=https://api.erp.flebosil.com
CSRF_TRUSTED_ORIGINS=
# Proxies delante de Django, para leer la IP real del cliente: 0 en local,
# 1 en Railway (api.erp.flebosil.com va sin el proxy de Cloudflare).
NUM_PROXIES=0

# En Railway, con referencias al servicio de PostgreSQL:
#   DB_NAME=${{Postgres.PGDATABASE}}  DB_USER=${{Postgres.PGUSER}}
#   DB_PASSWORD=${{Postgres.PGPASSWORD}}  DB_HOST=${{Postgres.PGHOST}}
#   DB_PORT=${{Postgres.PGPORT}}
DB_NAME=flebosil_db
DB_USER=flebosil
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Orígenes del frontend separados por comas. En producción:
#   CORS_ALLOWED_ORIGINS=https://erp.flebosil.com
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Carpetas de archivos subidos. Vacías en local (carpetas del proyecto). En
# Railway, dentro del Volume montado en /data, que sobrevive a cada despliegue:
#   MEDIA_ROOT=/data/media
#   EMPLEADOS_FOTOS_ROOT=/data/fotos_empleados
#   USUARIOS_FOTOS_ROOT=/data/fotos_usuarios
MEDIA_ROOT=
EMPLEADOS_FOTOS_ROOT=
USUARIOS_FOTOS_ROOT=

# Clave Fernet para cifrar ConfiguracionPAC.api_key_cifrada (feature 016).
# Generar una propia por entorno, ej.:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FISCAL_ENCRYPTION_KEY=change-me

# Correo saliente (004 · Recuperar contraseña). Sin EMAIL_BACKEND, se elige
# solo: con RESEND_API_KEY, la API de Resend; con EMAIL_HOST, SMTP; sin
# ninguna, los correos se imprimen en la consola (útil en local).
#
# Producción (Railway bloquea SMTP): una API key de https://resend.com y un
# remitente del dominio verificado en Resend, ej.:
#   RESEND_API_KEY=re_...
#   DEFAULT_FROM_EMAIL=FleboSil <no-reply@notificaciones.flebosil.com>
RESEND_API_KEY=
EMAIL_BACKEND=
DEFAULT_FROM_EMAIL=no-reply@notificaciones.flebosil.com
#
# Alternativa por SMTP (ej. Gmail en local): verificación en dos pasos, un App
# Password de https://myaccount.google.com/apppasswords (nunca la contraseña
# normal) y DEFAULT_FROM_EMAIL igual a EMAIL_HOST_USER.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# Solo con DEBUG=False. Segundos de HSTS: corto al inicio; subirlo (ej.
# 31536000) cuando el dominio esté estable.
SECURE_HSTS_SECONDS=3600

# Contraseña del administrador protegido admin@flebosil.com (022).
# Obligatoria para `manage.py asegurar_admin`; en producción, una contraseña fuerte.
ADMIN_PASSWORD=

# Respaldos (023). Contraseña de cifrado: guárdala también en un gestor de
# contraseñas; sin ella ningún respaldo se puede abrir.
RESPALDO_PASSWORD=
# A quién avisar por correo si un respaldo falla.
RESPALDO_AVISO_EMAIL=
# Cloudflare R2 (S3). Vacías en local: las facturas no se suben a ningún lado.
#   R2_ENDPOINT=https://<id de cuenta>.r2.cloudflarestorage.com
#   R2_BUCKET=flebosil-respaldos
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
