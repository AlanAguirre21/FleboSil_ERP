# Respaldo semanal en este equipo (023 · opción B). Copiar a `.env.respaldo`
# (fuera del repositorio) y llenarlo. Lo lee `scripts/respaldar_local.ps1`;
# estos valores tienen prioridad sobre los de `.env`.

# Python del entorno conda del proyecto.
PYTHON=C:\Users\<usuario>\miniconda3\envs\erp_flebosil\python.exe
# Carpeta de pg_dump/pg_restore 16 o más nuevo.
PG_BIN=C:\Program Files\PostgreSQL\16\bin
# Carpeta donde quedan los respaldos (se crea si no existe).
RESPALDO_CARPETA=C:\Respaldos\FleboSil

# Base de Railway por su conexión PÚBLICA (servicio Postgres → Variables →
# DATABASE_PUBLIC_URL: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE).
DB_HOST=
DB_PORT=
DB_NAME=railway
DB_USER=postgres
DB_PASSWORD=

# La misma contraseña de cifrado que en Railway.
RESPALDO_PASSWORD=
RESPALDO_AVISO_EMAIL=

# R2 con el token de SOLO LECTURA (para descargar las facturas).
R2_ENDPOINT=
R2_BUCKET=flebosil-respaldos
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
